<?xml version="1.0" encoding="utf-8"?>
<!-- 创作空间布局 - 编辑器 -->
<!-- 命名规范遵循 AGENTS.md 2.3节 -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedIds"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.editor.EditorActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            app:navigationIcon="@drawable/ic_back"
            app:titleTextColor="@color/text_primary">

            <TextView
                android:id="@+id/tv_save_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/spacing_md"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_caption"
                tools:text="已保存" />

        </androidx.appcompat.widget.Toolbar>

        <!-- 章节信息栏 -->
        <LinearLayout
            android:id="@+id/ll_chapter_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_sm">

            <ImageButton
                android:id="@+id/btn_prev_chapter"
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_ok"
                android:src="@drawable/ic_prev"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_chapter_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_h3"
                android:textStyle="bold"
                tools:text="第一章" />

            <ImageButton
                android:id="@+id/btn_next_chapter"
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_ok"
                android:src="@drawable/ic_next"
                app:tint="@color/text_secondary" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- 主内容区域 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 加载状态 -->
        <ProgressBar
            android:id="@+id/pb_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="gone" />

        <!-- 编辑内容区 -->
        <ScrollView
            android:id="@+id/sv_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <EditText
                android:id="@+id/etContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="top|start"
                android:hint="@string/hint_editor"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textAutoCorrect"
                android:minHeight="300dp"
                android:padding="@dimen/spacing_md"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                tools:text="这是一段测试内容..." />

        </ScrollView>

        <!-- AI生成状态覆盖层 -->
        <LinearLayout
            android:id="@+id/ll_ai_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ai_status"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_sm"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/pb_ai"
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:layout_marginEnd="@dimen/spacing_sm" />

            <TextView
                android:id="@+id/tv_ai_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_body_sm"
                tools:text="@string/ai_generating" />

            <Button
                android:id="@+id/btn_cancel_ai"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:minHeight="0dp"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_sm"
                android:text="@string/action_cancel"
                android:textColor="@color/error"
                android:textSize="@dimen/text_caption" />

        </LinearLayout>

        <!-- 底部操作栏 -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="@dimen/card_elevation"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_sm"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingEnd="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_sm"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btn_voice"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/editor_voice_input"
                android:padding="@dimen/spacing_xs"
                android:src="@drawable/ic_mic"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btn_undo"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_undo"
                android:padding="@dimen/spacing_xs"
                android:src="@drawable/ic_undo"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btn_redo"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_redo"
                android:padding="@dimen/spacing_xs"
                android:src="@drawable/ic_redo"
                app:tint="@color/text_secondary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_word_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_caption"
                tools:text="128字" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ai_generate"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:contentDescription="@string/cd_ai_generate"
                android:text="@string/editor_ai_generate"
                android:textColor="@color/on_primary"
                app:backgroundTint="@color/primary"
                app:cornerRadius="@dimen/corner_md"
                app:icon="@drawable/ic_ai"
                app:iconTint="@color/on_primary" />

            <ImageButton
                android:id="@+id/btn_new_chapter"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:layout_marginStart="@dimen/spacing_sm"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/editor_chapter_new"
                android:padding="@dimen/spacing_xs"
                android:src="@drawable/ic_add"
                app:tint="@color/primary" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
